# =====================================================================
# Operator pilot appendix
# =====================================================================
# Required to deploy /[operator] pages.

# Cookie signing secret. Min 16 chars. Use `openssl rand -hex 32`.
APPENDIX_SIGNING_SECRET=

# Per-operator passwords. Add one env var per operator slug, named
# OPERATOR_<SLUG>_PASSWORD. Slug uppercased, dashes replaced with _.
# Tom shares the password with the operator manually.
OPERATOR_GAMBLR_PASSWORD=
